#!/usr/bin/env bash
# Resume of ingest_global_s3a from tahoe (2026-09-25). Job C died 2026-09-24 23:43 at tahoe (WinError 5 renaming tahoe.zarr.tmp; it predated the store.py retry).
# Days already in the cube are skipped, so re-running a lake is cheap. Searches now wait out
# a local network outage (olci.wait_for_host) instead of failing.
# The filename deliberately contains "ingest_global.sh": run_global.sh waits while any process
# matching that is alive, and needs artifacts/ingest_global_s3a.json before merging.
set -u
cd "$(dirname "$0")/.."
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
PY=.venv/Scripts/python.exe
name=ingest_global_s3a
echo "$(date -Is) start ${name} (resume from tahoe)" >> artifacts/ingest_global.log
$PY pipelines/ingest.py --aoi data/aoi/lakes_global.geojson --cube-root data/processed/cubes_global_s3a     --source eumetsat-reprocessed --all-year --start 2016-05-01 --end 2017-10-31 --workers 6     --lakes tahoe valencia_ve maracaibo titicaca_puno guaiba taupo te_waihora     --report artifacts/$name.json > artifacts/${name}_resume.out 2>&1
rc=$?
echo "$(date -Is) done ${name} (resume) exit=$rc" >> artifacts/ingest_global.log
