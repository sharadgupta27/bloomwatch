#!/usr/bin/env bash
# Resume of ingest_global_B from upper_klamath (2026-09-25). The first resume died 01:39 on a DNS outage (network dropped).
# Days already in the cube are skipped, so re-running a lake is cheap. Searches now wait out
# a local network outage (olci.wait_for_host) instead of failing.
# The filename deliberately contains "ingest_global.sh": run_global.sh waits while any process
# matching that is alive, and needs artifacts/ingest_global_B.json before merging.
set -u
cd "$(dirname "$0")/.."
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
PY=.venv/Scripts/python.exe
name=ingest_global_B
echo "$(date -Is) start ${name} (resume from upper_klamath)" >> artifacts/ingest_global.log
$PY pipelines/ingest.py --aoi data/aoi/lakes_global.geojson --cube-root data/processed/cubes_global_new     --source planetary-computer --all-year --start 2017-11-01 --end 2025-12-31 --workers 7     --lakes upper_klamath winnebago lake_of_the_woods tahoe valencia_ve maracaibo titicaca_puno guaiba taupo te_waihora     --report artifacts/$name.json > artifacts/${name}_resume2.out 2>&1
rc=$?
echo "$(date -Is) done ${name} (resume) exit=$rc" >> artifacts/ingest_global.log
